@model ErrorViewModel
@{
    ViewData["Title"] = "Oops! Error Occurred";
}

<div class="d-flex flex-column align-items-center justify-content-center py-5 text-center min-vh-75">
    <div class="error-card glassmorphic p-5 rounded-4 shadow-lg text-center" style="max-width: 580px; border: 1px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(16px); box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);">
        <div class="error-icon-wrapper mb-4 d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; border-radius: 50%; background: #fff5f5; border: 4px solid #fee2e2;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="error-pulse-animation">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
        </div>
        
        <h1 class="h3 fw-bold mb-3" style="color: #0f172a; font-family: 'DM Sans', sans-serif;">Oops! Something went wrong</h1>
        
        <p class="text-muted mb-4 lead" style="font-size: 1.05rem; line-height: 1.6; font-family: 'DM Sans', sans-serif;">
            No connection could be made to the server, or an unexpected error occurred. Please try again after some time.
        </p>
        
        <div class="d-flex gap-3 justify-content-center mt-2">
            <a href="/" class="btn btn-primary px-4 py-2" style="background: var(--primary); border-color: var(--primary); border-radius: 8px; font-weight: 500;">
                Try Again
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 8px; font-weight: 500;">
                Go Back
            </a>
        </div>
        
        @if (Model?.ShowRequestId == true)
        {
            <div class="mt-4 pt-3 border-top text-muted small" style="font-size: 0.85rem; border-color: rgba(0, 0, 0, 0.08) !important;">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </div>
        }
    </div>
</div>
