@using StudentsWeb.Services
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Students Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Students" asp-action="Index">
                    <span class="brand-mark">SM</span>
                    <span class="brand-text">Students Management</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Students" asp-action="Index">Students</a>
                        </li>
                    </ul>
                    @{
                        var userName = Context.Session.GetString(SessionKeys.UserName);
                        var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString(SessionKeys.JwtToken));
                    }
                    @if (isLoggedIn)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <span class="user-pill text-muted small">
                                @(userName ?? "User")
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main container-fluid px-4 py-4">
        @RenderBody()
    </main>

    <footer class="app-footer text-center text-muted small py-3">
        &copy; @DateTime.Now.Year Students Management System
    </footer>

    <!-- Beautiful Custom Deletion Confirmation Modal -->
    <div id="deleteConfirmModal" class="custom-modal-backdrop d-none">
        <div class="custom-modal-card">
            <div class="custom-modal-icon-wrapper mb-3">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
            </div>
            <h3 class="custom-modal-title">Delete Student?</h3>
            <p class="custom-modal-text">Are you sure you want to delete this student? This action cannot be undone.</p>
            <div class="custom-modal-actions">
                <button type="button" id="btnCancelDelete" class="custom-modal-btn btn-cancel">Keep Student</button>
                <button type="button" id="btnConfirmDelete" class="custom-modal-btn btn-confirm">Yes, Delete</button>
            </div>
        </div>
    </div>

    <!-- Sleek Right-Side Toast Container -->
    <div id="custom-toast-container" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090; margin-top: 1.5rem;">
        @if (TempData["Success"] is string successMsg)
        {
            <div class="custom-toast success-toast" role="alert">
                <div class="toast-content-wrapper">
                    <span class="toast-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </span>
                    <div class="toast-text">
                        <div class="toast-title">Success</div>
                        <div class="toast-body-text">@successMsg</div>
                    </div>
                    <button type="button" class="toast-close-btn" onclick="this.closest('.custom-toast').classList.add('hide-toast'); setTimeout(() => this.closest('.custom-toast').remove(), 300);">&times;</button>
                </div>
                <div class="toast-progress-bar"><div class="toast-progress-fill"></div></div>
            </div>
        }
        @if (TempData["Error"] is string errorMsg)
        {
            <div class="custom-toast error-toast" role="alert">
                <div class="toast-content-wrapper">
                    <span class="toast-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </span>
                    <div class="toast-text">
                        <div class="toast-title">Error</div>
                        <div class="toast-body-text">@errorMsg</div>
                    </div>
                    <button type="button" class="toast-close-btn" onclick="this.closest('.custom-toast').classList.add('hide-toast'); setTimeout(() => this.closest('.custom-toast').remove(), 300);">&times;</button>
                </div>
                <div class="toast-progress-bar"><div class="toast-progress-fill"></div></div>
            </div>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
