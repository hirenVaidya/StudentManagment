@model IEnumerable<StudentViewModel>
@{
    ViewData["Title"] = "Students";
    var userName = Context.Session.GetString(StudentsWeb.Services.SessionKeys.UserName);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Students</h1>
        @if (!string.IsNullOrEmpty(userName))
        {
            <p class="text-muted mb-0">Signed in as @userName</p>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">Add student</a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
        </form>
    </div>
</div>



@if (!Model.Any())
{
    <p class="text-muted">No students yet. <a asp-action="Create">Add the first student</a>.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Created by</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.Name</td>
                        <td>@student.Email</td>
                        <td>@student.Phone</td>
                        <td>@student.CreatedByName</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary">Details</a>
                            <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@student.Id" method="post" class="d-inline form-delete-student">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn btn-sm btn-outline-danger btn-delete-student">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
