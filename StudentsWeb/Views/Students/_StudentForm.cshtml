@model StudentFormViewModel

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Email" class="form-label"></label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Phone" class="form-label"></label>
    <div class="input-group custom-phone-group">
        <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 custom-country-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="country-dropdown-btn">
            <span id="selected-flag">🇮🇳</span> <span id="selected-code">91</span>
        </button>
        <ul class="dropdown-menu custom-country-dropdown shadow-lg border-0" id="country-dropdown-list" style="max-height: 280px; overflow-y: auto; border-radius: 12px;">
            <li><a class="dropdown-item d-flex align-items-center gap-3 py-2" href="#" data-flag="🇮🇳" data-code="91" data-country="India">🇮🇳 India (+91)</a></li>
            <li><a class="dropdown-item d-flex align-items-center gap-3 py-2" href="#" data-flag="🇺🇸" data-code="1" data-country="United States">🇺🇸 USA (+1)</a></li>
            <li><a class="dropdown-item d-flex align-items-center gap-3 py-2" href="#" data-flag="🇬🇧" data-code="44" data-country="United Kingdom">🇬🇧 UK (+44)</a></li>
            <li><a class="dropdown-item d-flex align-items-center gap-3 py-2" href="#" data-flag="🇨🇦" data-code="1" data-country="Canada">🇨🇦 Canada (+1)</a></li>
            <li><a class="dropdown-item d-flex align-items-center gap-3 py-2" href="#" data-flag="🇦🇺" data-code="61" data-country="Australia">🇦🇺 Australia (+61)</a></li>
            <li><a class="dropdown-item d-flex align-items-center gap-3 py-2" href="#" data-flag="🇩🇪" data-code="49" data-country="Germany">🇩🇪 Germany (+49)</a></li>
            <li><a class="dropdown-item d-flex align-items-center gap-3 py-2" href="#" data-flag="🇸🇬" data-code="65" data-country="Singapore">🇸🇬 Singapore (+65)</a></li>
            <li><a class="dropdown-item d-flex align-items-center gap-3 py-2" href="#" data-flag="🇦🇪" data-code="971" data-country="UAE">🇦🇪 UAE (+971)</a></li>
        </ul>
        <input type="tel" id="phone-visual" class="form-control custom-phone-input" placeholder="Enter 10-digit mobile number" maxlength="10" autocomplete="tel" style="border-top-right-radius: 8px; border-bottom-right-radius: 8px;" />
        <input type="hidden" asp-for="Phone" id="phone-hidden" />
    </div>
    <span asp-validation-for="Phone" class="text-danger d-block mt-1" id="phone-error-msg"></span>
</div>
